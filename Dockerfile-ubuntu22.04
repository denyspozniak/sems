FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update
RUN apt-get install -y \
         git debhelper g++ make cmake libspandsp-dev flite1-dev \
         libspeex-dev libgsm1-dev libopus-dev libssl-dev python3-dev \
         python3-sip-dev libev-dev \
         openssl libmysqlcppconn-dev libevent-dev \
         libxml2-dev libcurl4-openssl-dev libhiredis-dev \
         cargo rustc

RUN apt-get install -y \
         devscripts libbcg729-dev \
         libsamplerate-dev libmp3lame-dev libcodec2-dev
COPY . /sems
WORKDIR /sems

RUN mkdir -p build && cd build && cmake .. && make sems_tests && ./core/sems_tests
RUN ln -s pkg/deb/bullseye ./debian
# PKG_VERSION from CI makes successive builds upgradable via apt (apt compares
# version strings only). Falls back to VERSION for a plain local build.
ARG PKG_VERSION=
RUN v="${PKG_VERSION:-$(cat VERSION)}" && \
    DEBEMAIL="ci@localhost" DEBFULLNAME="CI" dch -b -v "$v" "sems"
RUN dpkg-buildpackage -rfakeroot -us -uc
RUN ls -al ..

RUN dpkg -i ../sems_*.deb
RUN /usr/sbin/sems -v
RUN mkdir -p /debs && cp -a ../*.deb /debs/ && ls -al /debs

CMD ["/usr/sbin/sems", "-E", "-f", "/etc/sems/sems.conf"]
